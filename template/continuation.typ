/**
 * Строка "Продолжение таблицы N" над частями таблицы или листинга, перенесёнными на следующие страницы (ГОСТ 7.32-2017, п. 6.6.3).
 *
 * Тело фигуры помещается в сетку из одной колонки, заголовок которой повторяется на каждой странице.
 * Typst вычисляет контекст повторённого заголовка на каждой странице заново, поэтому строку видно только на страницах после первой.
 * Сама таблица не меняется, и правила, привязанные к номерам её строк и колонок, продолжают работать.
 *
 * Заголовок занимает одинаковую высоту на всех страницах: если высота меняется, Typst ошибается в месте для вложенной таблицы, и последние строки вылезают на нижнее поле.
 * На первой странице заголовок пуст, и сетка поднимается на его высоту, чтобы таблица стояла там же, где стояла бы без него.
 */

#import "numbering.typ": element-number

/// Кегль строки продолжения.
#let continuation-size = 14pt

/// Тело `body` фигуры `fig` со строкой "Продолжение `word` N" над каждой частью, перенесённой на следующую страницу.
/// Слово `word` пишется в родительном падеже: "таблицы", "листинга".
#let with-continuation(body, fig, word) = context {
  let height = measure(text(size: continuation-size)[Продолжение]).height + 0.45 * continuation-size
  let header = box(width: 0pt, height: height, context {
    if here().page() > fig.location().page() {
      let line = text(size: continuation-size)[Продолжение #word #element-number(fig)]
      // Строка не должна расширять сетку, иначе узкая таблица сместится влево от центра.
      place(top + left, box(width: measure(line).width, line))
    }
  })
  v(-height)
  grid(
    columns: 1,
    grid.header(grid.cell(inset: 0pt, align: left, header)),
    body,
  )
}
